# Capability settings only. Platform owns transport, authentication, logging,
# request deadlines, and hosted HTTP policy.

# Required: only files beneath these absolute roots may be read. Use the host
# path-list separator (":" on POSIX, ";" on Windows) or commas.
VISION_ALLOWED_ROOTS=/replace/with/an/allowed/root
# VISION_PYTHON_PATH=/absolute/path/to/python3
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_IMAGE_PIXELS=40000000

# Local profile
VISION_PROVIDER_MODE=local
VISION_DEFAULT_LANGUAGE=en
VISION_PADDLE_LANGUAGES=en

# Ephemeral filesystem artifacts
VISION_STORAGE_BACKEND=filesystem
VISION_ASSET_TTL_SECONDS=3600

# Wrapper and worker budgets
VISION_MAX_CONCURRENCY=2
VISION_MAX_QUEUE_DEPTH=8
VISION_OPERATION_TIMEOUT_SECONDS=60
VISION_PROVIDER_TIMEOUT_SECONDS=30
VISION_WORKER_TIMEOUT_MS=65000
VISION_WORKER_MAX_OUTPUT_BYTES=2097152

# Hybrid Azure profile (all values are required for the declared service-principal form)
# VISION_PROVIDER_MODE=azure
# VISION_AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://example.services.ai.azure.com
# AZURE_TENANT_ID=replace-with-tenant-id
# AZURE_CLIENT_ID=replace-with-client-id
# AZURE_CLIENT_SECRET=load-from-a-secret-manager
