# Copy to .env for local development. Replace every placeholder; no values in this
# repository are bound to any Azure account, tenant, subscription, or region.

# Service
VISION_ENVIRONMENT=development
VISION_LOG_LEVEL=INFO

# Authentication (production requires auth_enabled=true and at least one key)
VISION_AUTH_ENABLED=false
# VISION_API_KEYS=replace-with-a-generated-key,another-generated-key

# Local image inputs: only files beneath these roots may be read
VISION_ALLOWED_ROOTS=/replace/with/an/allowed/root
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_IMAGE_PIXELS=40000000

# OCR provider: local | azure | auto
VISION_PROVIDER_MODE=local
VISION_DEFAULT_LANGUAGE=en
VISION_PADDLE_LANGUAGES=en
# VISION_AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://<your-ai-services-account>.services.ai.azure.com

# Assets: filesystem | azure_blob
VISION_STORAGE_BACKEND=filesystem
VISION_ASSET_ROOT=./.vision-assets
VISION_ASSET_TTL_SECONDS=3600
# VISION_STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net
# VISION_ASSET_CONTAINER=vision-input
# VISION_ARTIFACT_CONTAINER=vision-artifacts

# Concurrency and timeouts
VISION_MAX_CONCURRENCY=4
VISION_OPERATION_TIMEOUT_SECONDS=60
VISION_PROVIDER_TIMEOUT_SECONDS=30
