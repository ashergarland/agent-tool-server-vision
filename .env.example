NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=agent-tool-server-template
SERVICE_VERSION=0.1.0
GIT_SHA=unknown
PUBLIC_BASE_URL=

# Development only. Production rejects disabled authentication.
AUTH_MODE=disabled
API_KEYS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Mutations are disabled unless both deployment and request explicitly permit them.
MUTATIONS_ENABLED=false
MUTATION_CONFIRMATION_REQUIRED=true
