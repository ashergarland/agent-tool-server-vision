          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetUploadResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Upload Asset",
        "tags": [
          "assets"
        ]
      }
    },
