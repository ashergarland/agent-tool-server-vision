            "title": "Status",
            "type": "string"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "tools",
          "components",
          "configuration"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ResultMeta": {
        "additionalProperties": false,
