          "id": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "page": {
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          },
          "polygon": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
