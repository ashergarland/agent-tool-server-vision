            "title": "Apiversion"
          },
          "mode": {
            "$ref": "#/components/schemas/ProcessingMode"
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "name": {
            "enum": [
              "local_paddleocr",
