          "webp"
        ],
        "title": "ImageFormat",
        "type": "string"
      },
      "LocalPathImage": {
        "additionalProperties": false,
        "description": "A regular file beneath one of the configured allowed roots.",
        "properties": {
          "kind": {
            "const": "local_path",
            "title": "Kind",
            "type": "string"
          },
          "path": {
            "maxLength": 4096,
