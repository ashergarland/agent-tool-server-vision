          "box": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "image": {
            "discriminator": {
              "mapping": {
                "asset": "#/components/schemas/AssetImage",
                "local_path": "#/components/schemas/LocalPathImage"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/LocalPathImage"
              },
              {
                "$ref": "#/components/schemas/AssetImage"
              }
            ],
            "title": "Image"
          },
          "maxHeight": {
            "default": 1024,
            "maximum": 8192.0,
            "minimum": 16.0,
            "title": "Maxheight",
            "type": "integer"
          },
          "maxWidth": {
            "default": 1024,
            "maximum": 8192.0,
            "minimum": 16.0,
            "title": "Maxwidth",
            "type": "integer"
          },
          "outputFormat": {
