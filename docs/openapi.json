          "height": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Height",
            "type": "number"
          },
          "width": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Width",
            "type": "number"
          },
          "x": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "NormalizedBox",
        "type": "object"
      },
      "OptimizeRegionInput": {
        "additionalProperties": false,
