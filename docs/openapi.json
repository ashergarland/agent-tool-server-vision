{
  "components": {
    "schemas": {
      "AssetImage": {
        "additionalProperties": false,
        "description": "An opaque asset identifier previously returned by the asset API.",
        "properties": {
          "assetId": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Assetid",
            "type": "string"
          },
          "kind": {
            "const": "asset",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "assetId"
        ],
        "title": "AssetImage",
        "type": "object"
      },
      "AssetUploadResponse": {
        "additionalProperties": false,
        "properties": {
          "assetId": {
            "title": "Assetid",
            "type": "string"
          },
          "byteCount": {
            "title": "Bytecount",
            "type": "integer"
          },
          "contentType": {
            "title": "Contenttype",
            "type": "string"
          },
          "expiresAt": {
            "title": "Expiresat",
            "type": "string"
          }
        },
        "required": [
          "assetId",
          "byteCount",
          "contentType",
          "expiresAt"
        ],
        "title": "AssetUploadResponse",
        "type": "object"
      },
      "BlockType": {
        "enum": [
          "line",
          "paragraph",
          "word"
        ],
        "title": "BlockType",
        "type": "string"
      },
      "BoundingBox": {
        "additionalProperties": false,
        "description": "Pixel box using the top-left origin convention: x/y are inclusive.",
        "properties": {
          "height": {
            "exclusiveMinimum": 0.0,
            "maximum": 1000000.0,
            "title": "Height",
            "type": "integer"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "maximum": 1000000.0,
            "title": "Width",
            "type": "integer"
          },
          "x": {
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "X",
            "type": "integer"
          },
          "y": {
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Y",
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "BoundingBox",
        "type": "object"
      },
      "ChangedRegion": {
        "additionalProperties": false,
        "properties": {
          "box": {
            "$ref": "#/components/schemas/BoundingBox"
          },
          "changedPixels": {
            "minimum": 1.0,
            "title": "Changedpixels",
            "type": "integer"
          }
        },
        "required": [
          "box",
          "changedPixels"
        ],
        "title": "ChangedRegion",
        "type": "object"
      },
      "CompareImagesInput": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "discriminator": {
              "mapping": {
                "asset": "#/components/schemas/AssetImage",
                "local_path": "#/components/schemas/LocalPathImage"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/LocalPathImage"
              },
              {
                "$ref": "#/components/schemas/AssetImage"
              }
            ],
            "title": "After"
          },
          "before": {
            "discriminator": {
              "mapping": {
                "asset": "#/components/schemas/AssetImage",
                "local_path": "#/components/schemas/LocalPathImage"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/LocalPathImage"
              },
              {
                "$ref": "#/components/schemas/AssetImage"
              }
            ],
            "title": "Before"
          },
          "includeDiff": {
            "default": false,
            "title": "Includediff",
            "type": "boolean"
          },
          "maxRegions": {
            "default": 20,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Maxregions",
            "type": "integer"
          },
          "threshold": {
            "default": 0.05,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "type": "number"
          }
        },
        "required": [
          "before",
          "after"
        ],
        "title": "CompareImagesInput",
        "type": "object"
      },
      "CompareImagesOutput": {
        "additionalProperties": false,
        "properties": {
          "afterDimensions": {
            "$ref": "#/components/schemas/Dimensions"
          },
          "beforeDimensions": {
            "$ref": "#/components/schemas/Dimensions"
          },
          "changedPixels": {
            "minimum": 0.0,
            "title": "Changedpixels",
            "type": "integer"
          },
          "changedRatio": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Changedratio",
            "type": "number"
          },
          "comparisonDimensions": {
            "$ref": "#/components/schemas/Dimensions"
          },
          "diffArtifactId": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diffartifactid"
          },
          "dimensionsChanged": {
            "title": "Dimensionschanged",
            "type": "boolean"
          },
          "meta": {
            "$ref": "#/components/schemas/ResultMeta"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/ChangedRegion"
            },
            "maxItems": 100,
            "title": "Regions",
            "type": "array"
          },
          "similarityScore": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Similarityscore",
            "type": "number"
          }
        },
        "required": [
          "similarityScore",
          "beforeDimensions",
          "afterDimensions",
          "dimensionsChanged",
          "comparisonDimensions",
          "changedPixels",
          "changedRatio"
        ],
        "title": "CompareImagesOutput",
        "type": "object"
      },
      "ComponentStatus": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "ComponentStatus",
        "type": "object"
      },
      "Dimensions": {
        "additionalProperties": false,
        "properties": {
          "height": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Height",
            "type": "integer"
          },
          "width": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "width",
          "height"
        ],
        "title": "Dimensions",
        "type": "object"
      },
      "ExtractTextInput": {
        "additionalProperties": false,
        "properties": {
          "image": {
            "discriminator": {
              "mapping": {
                "asset": "#/components/schemas/AssetImage",
                "local_path": "#/components/schemas/LocalPathImage"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/LocalPathImage"
              },
              {
                "$ref": "#/components/schemas/AssetImage"
              }
            ],
            "title": "Image"
          },
          "includeCoordinates": {
            "default": true,
            "title": "Includecoordinates",
            "type": "boolean"
          },
          "language": {
            "anyOf": [
              {
                "maxLength": 16,
                "minLength": 2,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "outputFormat": {
            "$ref": "#/components/schemas/OutputFormat",
            "default": "markdown"
          },
          "processingMode": {
            "$ref": "#/components/schemas/ProcessingMode",
            "default": "auto"
          }
        },
        "required": [
          "image"
        ],
        "title": "ExtractTextInput",
        "type": "object"
      },
      "ExtractTextOutput": {
        "additionalProperties": false,
        "properties": {
          "blocks": {
            "items": {
              "$ref": "#/components/schemas/TextBlock"
            },
            "maxItems": 500,
            "title": "Blocks",
            "type": "array"
          },
          "content": {
            "maxLength": 200000,
            "title": "Content",
            "type": "string"
          },
          "dimensions": {
            "$ref": "#/components/schemas/Dimensions"
          },
          "fallbackUsed": {
            "default": false,
            "title": "Fallbackused",
            "type": "boolean"
          },
          "meta": {
            "$ref": "#/components/schemas/ResultMeta"
          },
          "provider": {
            "$ref": "#/components/schemas/ProviderInfo"
          }
        },
        "required": [
          "content",
          "dimensions",
          "provider"
        ],
        "title": "ExtractTextOutput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
